{
  "name": "masrimcp/acme-sdk",
  "description": "Math operations SDK",
  "type": "library",
  "license": "Apache-2.0",
  "keywords": [
    "acme",
    "sdk",
    "math"
  ],
  "require": {
    "php": "^7.3 || ^8.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^1.0",
    "phpunit/phpunit": "^9.0 || ^10.0"
  },
  "autoload": {
    "psr-4": {
      "Acme\\Sdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Acme\\Sdk\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "if php -m | grep -E 'xdebug|pcov' >/dev/null; then phpunit --coverage-clover coverage/clover.xml; else echo 'No coverage driver detected, running tests without coverage.'; phpunit; fi",
    "analyze": "phpstan analyse",
    "lint": "php-cs-fixer fix --dry-run --diff --verbose src tests",
    "lint:fix": "php-cs-fixer fix --verbose src tests",
    "bc-check": "docker run --rm -v $(pwd):/app -w /app ghcr.io/roave/backward-compatibility-check:8.3 --from=origin/main",
    "check": [
      "@analyze",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "preferred-install": "dist"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
